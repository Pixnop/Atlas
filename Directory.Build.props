<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <!-- Run the IDE code-style analyzers during the build, so .editorconfig is enforced by CI
         and not only by whoever happens to open the file in an IDE. -->
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>

    <!--
      Suppressions (project-wide). Each entry is a rule the code really breaks; a rule that
      fires nowhere does not belong here, so it stays out until something needs it.
      SA1633 - file header (we use a project-level LICENSE, not per-file headers)
      SA1200 - using directives outside namespace (we use top-level using directives)
      SA1101 - prefix local calls with this (idiomatic C# omits 'this.')
      SA1309 - field names starting with underscore (we DO use _ prefix; rule conflicts with .editorconfig style)
      SA1623 - property summary should begin with "Gets" - too restrictive
      SA1204 - static members before instance members: ordering only, about 15 sites, and moving
               them apart would split members that read better next to each other
      CS1705 - a referenced assembly has a higher version than the same assembly referenced
               indirectly. The game DLLs of the older CI matrix lanes (the 1.21.7 floor) mix
               runtime references this way; it does not fire on 1.22 alone. Drop it once the
               floor lane no longer needs it.
    -->
    <NoWarn>$(NoWarn);SA1633;SA1200;SA1101;SA1309;SA1623;CS1705;SA1204</NoWarn>

    <!-- MSB3277: cross-version System.* unification noise; VS DLL is compiled against a different runtime ref. -->
    <MSBuildWarningsAsMessages>MSB3277</MSBuildWarningsAsMessages>

    <!-- Single source of truth for every version the build emits: AssemblyVersion,
         FileVersion, InformationalVersion and PackageVersion all derive from Version, so a
         release only has to override this one property (release.yml passes -p:Version from
         the tag). -->
    <Version>0.12.1</Version>

    <Authors>Pixnop</Authors>
    <Product>Atlas</Product>
    <Copyright>Copyright (c) Pixnop</Copyright>

    <VintageStoryPath>$(VINTAGE_STORY)</VintageStoryPath>
  </PropertyGroup>

  <!-- Shared NuGet pack metadata for the four packable projects (src/Atlas, src/Atlas.Bridge,
       src/Atlas.XUnit, src/Atlas.Cli). IsPackable is opted in per-project; tests and samples
       stay unpackable. -->
  <PropertyGroup>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/Pixnop/Atlas</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Pixnop/Atlas</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>See https://github.com/Pixnop/Atlas/releases</PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.NetAnalyzers" Version="9.0.0" PrivateAssets="all" />
    <PackageReference Include="StyleCop.Analyzers" Version="1.2.0-beta.556" PrivateAssets="all" />
  </ItemGroup>
</Project>
