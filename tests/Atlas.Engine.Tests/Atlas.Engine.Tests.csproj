<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <NoWarn>$(NoWarn);CS1591;SA0001;SA1600;SA1601;SA1602</NoWarn>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- Shared with Atlas.GuineaPig.Scenarios (ADR 0010, docs/adr/0010-scenario-ordering.md):
         linked rather than referenced, so it compiles into this project's own assembly and its
         [TestCaseOrderer] assembly-qualified name resolves within that assembly. Kept internal
         (see AlphabeticalOrderer.cs): this project's own ProjectReference to
         Atlas.GuineaPig.Scenarios below is unrelated (NestedRunnerTests), but would otherwise
         import a same-named public type from that project's build of this same file. -->
    <Compile Include="..\TestSupport\AlphabeticalOrderer.cs" Link="AlphabeticalOrderer.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.*" />
    <PackageReference Include="xunit.runner.utility" Version="2.9.*" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageReference Include="NSubstitute" Version="5.1.0" />
    <PackageReference Include="coverlet.collector" Version="6.0.2">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <!--
      Private=true (default): unlike Atlas/Atlas.Bridge, this test project's own code references
      VintagestoryAPI types directly (BlockPos, ICoreServerAPI) in test method bodies. The CLR
      resolves a method's full signature, including such types, when the test runner JITs it via
      reflection - before any of Atlas's own boot code (which installs a late AssemblyResolve
      hook on the game thread) ever runs. Copying the dll to this project's own output directory
      sidesteps that ordering gap entirely.
    -->
    <Reference Include="VintagestoryAPI">
      <HintPath>$(VintageStoryPath)\VintagestoryAPI.dll</HintPath>
    </Reference>
    <!--
      Compile-time only (Private=false): ClientEntityObservationTests drives a few engine internals
      directly (the game-tick listener list, a raw server packet, a client leave packet) through
      Support/EngineProbes, whose members are the only code here that names VintagestoryLib types.
      The assembly itself is never copied: the game install's copy is the one that loads, through
      the same late resolver the host uses, so a test method that named one of these types before
      its host booted would fail to JIT. Keep them in that class.
    -->
    <Reference Include="VintagestoryLib">
      <HintPath>$(VintageStoryPath)\VintagestoryLib.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <ProjectReference Include="..\..\src\Atlas\Atlas.csproj" />
    <ProjectReference Include="..\..\src\Atlas.Cli\Atlas.Cli.csproj" />
    <ProjectReference Include="..\..\src\Atlas.XUnit\Atlas.XUnit.csproj" />
    <!-- Not a code dependency: copies the deliberately-failing guinea pig assembly into this
         project's output so NestedRunnerTests can execute it through an in-process runner. -->
    <ProjectReference Include="..\Atlas.GuineaPig.Scenarios\Atlas.GuineaPig.Scenarios.csproj" />
    <!-- Not a code dependency either: copies the fixture-builder guinea pig assembly into this
         project's output so FixtureCommandTests can drive `atlas fixture` against it. -->
    <ProjectReference Include="..\Atlas.Fixture.Scenarios\Atlas.Fixture.Scenarios.csproj" />
    <!-- Build order only (ReferenceOutputAssembly=false): the two-builds scenarios run from their
         own output folder, which holds the two builds of the mod identity and, unlike this
         project's output, has no copy of that identity next to the assembly. TwoBuildsTests
         drives them through the CLI. -->
    <ProjectReference Include="..\Atlas.TwoBuilds.Scenarios\Atlas.TwoBuilds.Scenarios.csproj"
                      ReferenceOutputAssembly="false" />
    <!-- Not a code dependency either (and deliberately NOT tagged AtlasMod: it must not be
         staged into every host this project boots): copies the rollback-hook fixture mod dll
         into this project's output so RollbackHookTests / MiniDimensionRollbackTests can stage
         it explicitly on the hosts that exercise the stage 3 mod-cooperation contract. -->
    <ProjectReference Include="..\RollbackHookFixtureMod\RollbackHookFixtureMod.csproj" />
    <!-- Same arrangement for the client-capture fixture mod (a mod network channel with one
         protobuf message), staged explicitly by ClientObservationTests. -->
    <ProjectReference Include="..\ClientCaptureFixtureMod\ClientCaptureFixtureMod.csproj" />
    <!-- Same arrangement for the tick-timing fixture mod (a tick listener with a known,
         deliberately expensive cost), staged explicitly by TickTimingTests. -->
    <ProjectReference Include="..\TickTimingFixtureMod\TickTimingFixtureMod.csproj" />
    <!-- Not a code dependency either: builds the boot-diagnostics fixture mod (its own dll ends
         up next to its modinfo.json/assets/, see its csproj) so BootDiagnosticsTests can stage
         the folder, unchanged path from before this mod had any code in it. -->
    <ProjectReference Include="..\BootDiagnosticsFixtureMod\BootDiagnosticsFixtureMod.csproj" />
    <!-- Same arrangement for the player-command fixture mod (a RequiresPlayer command with a
         privilege gate and a deferred argument), staged explicitly by PlayerExecuteCommandTests. -->
    <ProjectReference Include="..\PlayerCommandFixtureMod\PlayerCommandFixtureMod.csproj" />
    <!-- Not a code dependency either: a plain dependency dll (no ModSystem, no ModInfoAttribute)
         copied into this project's output so BootDiagnosticsTests can stage it by itself,
         reproducing the "declared as code mod" failure a dependency dll gets when it is listed
         in AtlasMods next to the real mod instead of alongside it. -->
    <ProjectReference Include="..\DependencyLibraryFixture\DependencyLibraryFixture.csproj" />
    <!-- A mod that uses DependencyLibraryFixture (above), for StagedModDependencyTests. Build-only
         (ReferenceOutputAssembly=false) and copied into dependent-mod/ below, so that no copy of
         it sits next to this assembly: the engine binds the first one a host stages, the way it
         does for a mod that has no ProjectReference at all. -->
    <ProjectReference Include="..\DependentFixtureMod\DependentFixtureMod.csproj"
                      ReferenceOutputAssembly="false" OutputItemType="DependentBuild" />
    <!-- Two builds of ONE mod identity (same AssemblyName, same frozen AssemblyVersion, different
         code) for StagedModBindingTests (issue #170). Alpha is a plain reference, so its dll lands
         next to this assembly, where the default binding picks it up: the "already bound" build.
         Beta is build-only (ReferenceOutputAssembly=false keeps its same-named dll out of the
         output root) and CopyBindingBetaBuild below puts it in binding-beta/, from where the
         tests stage it as the "other" build. -->
    <ProjectReference Include="..\BindingFixtureMod.Alpha\BindingFixtureMod.Alpha.csproj" />
    <ProjectReference Include="..\BindingFixtureMod.Beta\BindingFixtureMod.Beta.csproj"
                      ReferenceOutputAssembly="false" OutputItemType="BindingBetaBuild" />
    <!-- The scratch probe: a real test project that ScratchHygieneTests runs as a subprocess
         (dotnet test, atlas run, atlas run in parallel mode, atlas fixture) to count the scratch
         directories each leaves. Build-only: the subprocesses run it from its own output
         folder, whose path the AssemblyMetadata item below hands to the tests, so it is not
         copied here. -->
    <ProjectReference Include="..\Atlas.Scratch.Scenarios\Atlas.Scratch.Scenarios.csproj"
                      ReferenceOutputAssembly="false" />
    <!-- A scenario assembly that requires the game version it was compiled against and carries one
         no install has, so its boot always fails: GameVersionLineTests runs it through the CLI.
         Build-only like the probe above; the path below is how the tests find its output. -->
    <ProjectReference Include="..\Atlas.RequiredVersion.Scenarios\Atlas.RequiredVersion.Scenarios.csproj"
                      ReferenceOutputAssembly="false" />
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>RequiredVersionDll</_Parameter1>
      <_Parameter2>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\Atlas.RequiredVersion.Scenarios\bin\$(Configuration)\$(TargetFramework)\Atlas.RequiredVersion.Scenarios.dll'))</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>ScratchProbeDll</_Parameter1>
      <_Parameter2>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\Atlas.Scratch.Scenarios\bin\$(Configuration)\$(TargetFramework)\Atlas.Scratch.Scenarios.dll'))</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <!--
    The test SDK pulls an older Newtonsoft.Json transitively (13.0.1) that lands in this
    project's own output directory and shadows the game's own copy (13.0.4, a build VS ships
    that is not a plain NuGet release) during normal assembly probing, which runs BEFORE Atlas's
    AssemblyResolve fallback ever fires. VintagestoryLib/VintagestoryAPI are compiled against
    that exact Lib copy, so a version bump here would only paper over the symptom. The shared
    E2E targets overwrite the probed copy after build with the install's own file: this runs
    unconditionally after NuGet and ResolveAssemblyReference have already decided what goes in
    bin, so it always wins.
  -->
  <Target Name="CopyBindingBetaBuild" AfterTargets="Build">
    <Copy SourceFiles="@(BindingBetaBuild)" DestinationFolder="$(OutDir)binding-beta" />
  </Target>

  <Target Name="CopyDependentFixtureBuild" AfterTargets="Build">
    <Copy SourceFiles="@(DependentBuild)" DestinationFolder="$(OutDir)dependent-mod" />
  </Target>

  <Import Project="..\..\build\Atlas.E2E.targets" />

</Project>
