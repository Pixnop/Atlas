<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>Atlas.Cli</AssemblyName>
    <RootNamespace>Atlas.Cli</RootNamespace>
  </PropertyGroup>

  <!-- NuGet packaging: a `dotnet tool` exposing the `atlas` command. The CLI deliberately does
       NOT SHIP src/Atlas: the scenario assembly it runs already ships the whole harness (Atlas,
       Atlas.XUnit, Atlas.Bridge) in its own output directory, and the CLI resolves everything
       from there at run time (ScenarioAssemblyResolver). Its only real dependency is the
       in-process xunit runner. -->
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>atlas</ToolCommandName>
    <PackageId>Pixnop.Atlas.Cli</PackageId>
    <Description>Command line runner for the Atlas integration-test harness: executes Atlas scenarios from a compiled test assembly without VSTest (atlas run path/to/Scenarios.dll).</Description>
    <PackageTags>vintagestory;vsmod;testing;cli;xunit</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\docs\nuget-readme.md" Pack="true" PackagePath="\" />
    <None Include="..\..\docs\assets\nuget-icon.png" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Atlas.Pure.Tests" />
    <InternalsVisibleTo Include="Atlas.Engine.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="xunit.runner.utility" Version="2.9.*" />
    <!-- The three CLI-to-harness seams (atlas stage's EngineStager/EngineStaging call, atlas
         fixture's harvest, worker mode's isolation-summary sink) all call compiled signatures
         instead of locating members by name. Private=false + PrivateAssets=all: compile time
         only, so neither Atlas.dll nor Atlas.XUnit.dll is copied into the CLI's own output
         (which would shadow a scenario's own copy during atlas run's default probing, exactly
         the version hazard ScenarioAssemblyResolver exists to avoid) nor added as a package
         dependency of the packed Pixnop.Atlas.Cli tool. At run time the real bytes come from
         the target's own directory, through ScenarioAssemblyResolver or
         StageAssemblyResolver; HarnessSeam turns a version mismatch into a diagnostic. -->
    <ProjectReference Include="..\Atlas\Atlas.csproj">
      <Private>false</Private>
      <PrivateAssets>all</PrivateAssets>
      <ExcludeAssets>runtime</ExcludeAssets>
    </ProjectReference>
    <ProjectReference Include="..\Atlas.XUnit\Atlas.XUnit.csproj">
      <Private>false</Private>
      <PrivateAssets>all</PrivateAssets>
      <ExcludeAssets>runtime</ExcludeAssets>
    </ProjectReference>
  </ItemGroup>

  <!-- The referenced projects' OWN ProjectReferences carry no Private=false of their own
       (rightly: their other consumers need the files copied), and MSBuild does not propagate
       the Private=false above through that second hop, so Atlas.XUnit drags Atlas.dll and
       AtlasBridge.dll in behind it. Strip them (and their pdb/xml) from the resolved copy-local
       set explicitly, so they never land next to Atlas.Cli's own output either: the same
       version-independence reasoning as the ProjectReference comment above applies to them too.
       xunit.extensibility.execution comes the same way and is just as unwelcome next to the CLI,
       which must load the scenario assembly's own xunit copies, not a second set. -->
  <Target Name="ExcludeTransitiveAtlasAssembliesFromOutput" AfterTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <ReferenceCopyLocalPaths Remove="@(ReferenceCopyLocalPaths)"
                               Condition="'%(Filename)' == 'AtlasBridge' Or '%(Filename)' == 'Atlas' Or '%(Filename)' == 'Atlas.XUnit'" />
    </ItemGroup>
  </Target>

</Project>
