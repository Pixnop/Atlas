<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <AssemblyName>Atlas.XUnit</AssemblyName>
    <RootNamespace>Atlas.XUnit</RootNamespace>

    <!-- This is shipped library code, not a test project. The xunit.extensibility.execution
         reference below pulls xunit.core.dll, which is what dotnet-sonarscanner looks for when
         it decides a project holds tests, so without this line all 29 files here are analysed
         as test code: no main-code rules, and no coverage figure for a published package. -->
    <SonarQubeTestProject>false</SonarQubeTestProject>
  </PropertyGroup>

  <!-- NuGet packaging: the package consumers install. Depends on Pixnop.Atlas (via
       ProjectReference below), xunit.extensibility.execution and xunit.assert (0.14.1: a
       consumer no longer has to add the `xunit` metapackage itself just to get Assert; see
       the packages below). Ships build/Atlas.E2E.targets as buildTransitive so out-of-repo
       consumers get the Newtonsoft.Json shadowing fix, the VintageStoryPath env fallback and
       the xUnit v3 build guard automatically, without a manual relative <Import>. Also packed
       under build/ for consumers that prefer a direct, non-transitive import. Both copies are
       packed under a net10.0 folder (0.14.1: was the package root), because our dependencies
       below are declared for net10.0 only and NuGet treats a root-level build/buildTransitive
       file as compatible with every framework: on an older-TFM consumer that let install
       succeed silently with neither Pixnop.Atlas nor Pixnop.Atlas.Bridge, then fail the build
       with CS0246. A net10.0 folder makes that install fail restore instead, with NU1202. -->
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>Pixnop.Atlas.XUnit</PackageId>
    <Description>xUnit adapter for the Atlas integration-test harness: scenario attributes, world fixtures, and the buildTransitive MSBuild fix E2E consumers need.</Description>
    <PackageTags>vintagestory;vsmod;testing;xunit</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\docs\nuget-readme.md" Pack="true" PackagePath="\" />
    <None Include="..\..\docs\assets\nuget-icon.png" Pack="true" PackagePath="\" />
    <None Include="..\..\build\Atlas.E2E.targets" Pack="true" PackagePath="buildTransitive/net10.0/Pixnop.Atlas.XUnit.targets" />
    <None Include="..\..\build\Atlas.E2E.targets" Pack="true" PackagePath="build/net10.0/Pixnop.Atlas.XUnit.targets" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Atlas.Pure.Tests" />
    <InternalsVisibleTo Include="Atlas.Engine.Tests" />
    <InternalsVisibleTo Include="Atlas.GuineaPig.Scenarios" />
    <!-- atlas fixture harvests through HostRegistry and worker mode installs
         IsolationSummarySink directly, loaded from the scenario assembly's own Atlas.XUnit.dll
         copy at run time (see Atlas.Cli's ScenarioAssemblyResolver); this only grants
         compile-time visibility for the ProjectReference in Atlas.Cli.csproj. -->
    <InternalsVisibleTo Include="Atlas.Cli" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="xunit.extensibility.execution" Version="2.9.*" />
    <!-- Brings Assert: a consumer who only adds Pixnop.Atlas.XUnit, and not the `xunit`
         metapackage itself, can still compile Assert.* calls (CS0103 before 0.14.1). -->
    <PackageReference Include="xunit.assert" Version="2.9.*" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Atlas\Atlas.csproj" />
  </ItemGroup>

</Project>
